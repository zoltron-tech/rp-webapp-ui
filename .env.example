# ─── Discord OAuth2 ───────────────────────────────────────────────────────────
# Your Discord application client ID from https://discord.com/developers/applications
# Used for the "Continue with Discord" OAuth2 flow.
# See https://discord.com/developers/docs/topics/oauth2
NEXT_PUBLIC_DISCORD_CLIENT_ID=
NEXT_PUBLIC_DISCORD_INVITE_URL=

# ─── Backend service ──────────────────────────────────────────────────────────
# Base URL of the user/portfolio backend.
# LOCAL (no nginx): set RP_SERVICE_URL=http://localhost:3000 and enable the
# built-in dev proxy below — Next forwards /rp/user and /rp/portfolio to the
# local Spring services. PROD: the real api origin.
RP_SERVICE_URL=
RP_CHAT_URL=
RP_LOGIN_URL=

# ─── Local backend proxy (dev only, replaces nginx) ───────────────────────────
# Set to true to forward backend calls through Next to the local services.
LOCAL_BACKEND_PROXY=false
LOCAL_USER_SERVICE_URL=http://localhost:50100
LOCAL_PORTFOLIO_SERVICE_URL=http://localhost:50200

# ─── App config ───────────────────────────────────────────────────────────────
SUPPORT_EMAIL=
VAPID_PUBLIC_KEY=
LOG_LEVEL=info
DISABLE_AUTOSCROLL=false
# Set true for local dev (localhost:3000): makes the auth cookie host-only and
# non-secure so it works over http. Required for Discord linking on localhost.
USE_LOCAL_DOMAIN=false
KLIPY_API_KEY=
RP_BUCKET_NAME=

# ─── Chat E2E encryption ──────────────────────────────────────────────────────
# Legacy secret used only to DECRYPT interim "e2e:v1:" messages (see
# src/utils/e2e-crypto.ts). Current messages use per-user ECDH keys instead.
# Optional — a built-in default is used when unset. Must keep whatever value
# was active while v1 messages were being sent, until they age out (14 days).
NEXT_PUBLIC_CHAT_E2E_SECRET=

# Feature flag: encrypt outgoing chat messages. Unset/empty → messages send as
# plaintext (key exchange, envelope repair, and decryption still run). Set to
# any non-empty value (e.g. true) to encrypt.
NEXT_PUBLIC_CHAT_E2E_ENABLED=