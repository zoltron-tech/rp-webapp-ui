# Flat node_modules, for one reason: Windows path length.
#
# pnpm's default isolated layout puts every package under
# `.pnpm/<name>@<version>_<hash>/node_modules/<name>/`, which adds ~70
# characters to every path. React Native's new architecture compiles C++ from
# inside those directories, and CMake refuses object paths over 250 characters —
# `ninja: error: manifest 'build.ninja' still dirty after 100 tries`, which says
# nothing about paths at all. Hoisting removes the `.pnpm/...` segment and the
# builds fit.
#
# This is also what Expo's monorepo documentation recommends for pnpm. The cost
# is that the tree is npm-flat, so a package can require something it does not
# declare and get away with it — `pnpm check:boundaries` and each package's own
# `tsc` are what still police the dependency rules.
node-linker=hoisted
