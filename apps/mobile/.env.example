# Expo inlines EXPO_PUBLIC_* at build time and nothing else, the same guarantee
# the web app gets from Vite's VITE_ prefix. Never put a secret behind it.
#
# Copy to `.env`. Metro reads it automatically; restart Metro after a change,
# and rebuild the app if you change one that is read at startup.

# The API. Emulator: 10.0.2.2 is the host machine's localhost.
#   local backend  → http://10.0.2.2:8080
#   physical device → http://<your-LAN-ip>:8080
#   production      → https://api.novelist.world
EXPO_PUBLIC_RP_SERVICE_URL=https://api.novelist.world

# The S3 bucket every uploaded image lives in. Without it `@nw/utils/image`
# cannot tell our URLs from anyone else's, so it passes them all through
# untouched and the app downloads full-resolution originals into list rows —
# a 3KB banner arrives as 79KB, and the decoded bitmap is the full-size one.
# It fails silently; the only symptom is a list that reloads its images.
#
# Not a secret: it is already the hostname of every image URL the app renders.
EXPO_PUBLIC_RP_BUCKET_NAME=rp-webapp-ui

# CloudFront media host (e.g. media.novelist.world), no scheme. Stored S3 media
# URLs are rewritten to it at read time (AWS_COST_SECURITY_PLAN.md §3.2).
# Leave empty until the distribution and the backend's §3.3 changes are live.
EXPO_PUBLIC_RP_MEDIA_HOST=

# Must match the "scheme" in app.json, or the OAuth redirect has nowhere to land.
EXPO_PUBLIC_OAUTH_REDIRECT_SCHEME=novelistworld

EXPO_PUBLIC_DISCORD_INVITE_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_RP_CHAT_URL=

# The web app, for links the phone hands to other people — a shared prompt
# opens in a browser, not in this app. Defaults to production when unset.
EXPO_PUBLIC_WEB_URL=https://novelist.world

# The chat-server WebSocket, same value as the web build's VITE_SOCKET_URL.
#   local chat-server -> ws://10.0.2.2:8081 (emulator) or ws://<LAN ip>:8081
#   production        -> wss://<your chat host>
#
# Leaving it empty is not a build error and not a runtime error: chat falls back
# to polling every eight seconds and every novelist renders as offline, with
# nothing on screen to say why. There is a console warning in development only.
EXPO_PUBLIC_SOCKET_URL=

# ── Chat encryption ──────────────────────────────────────────────────────────
# The client half of every conversation key. It MUST be byte-for-byte the same
# value the web build uses (`VITE_CHAT_E2E_SECRET` in apps/web/.env) — the two
# clients derive the message key from it, so a different value here does not
# fail loudly, it just renders every message as
# "🔒 This message could not be decrypted."
#
# Not a secret in any meaningful sense: it ships inside the app bundle, and the
# scheme is encryption at rest rather than end-to-end (see packages/chat).
EXPO_PUBLIC_CHAT_E2E_SECRET=

# Whether *sending* encrypts. Decryption is always on, so turning this off never
# hides existing history. Match the web build unless you are testing.
EXPO_PUBLIC_CHAT_E2E_ENABLED=
