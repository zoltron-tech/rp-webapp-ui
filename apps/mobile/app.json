    "android": {
      "package": "world.novelist.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "host": "www.novelist.world",
              "pathPrefix": "/rp/story/",
              "scheme": "https"
            },
            {
              "host": "www.novelist.world",
              "path": "/rp/reset-password",
              "scheme": "https"
            },
            {
              "host": "www.novelist.world",
              "path": "/rp/verify-email",
              "scheme": "https"
            },
            {
              "host": "www.novelist.world",
              "path": "/rp/login",
              "scheme": "https"
            },
            {
              "host": "novelist.world",
              "pathPrefix": "/rp/story/",
              "scheme": "https"
            },
            {
              "host": "novelist.world",
              "path": "/rp/reset-password",
              "scheme": "https"
            },
            {
              "host": "novelist.world",
              "path": "/rp/verify-email",
              "scheme": "https"
            },
            {
              "host": "novelist.world",
              "path": "/rp/login",
              "scheme": "https"
            }
          ]
        }
      ],
      "edgeToEdgeEnabled": true,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icons/jade-foreground.png",
        "backgroundImage": "./assets/app-icons/jade-background.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e5f4d"
      },
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo-mark.png",
          "color": "#1f6f5c",
          "defaultChannel": "other"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Novelist World uses the camera when you choose to take a photo to send in a conversation.",
          "photosPermission": "Novelist World uses the photos and videos you choose for your profile picture and banner, your characters' images and galleries, your stories and maps, and the posts and messages you send.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "./plugins/with-animated-webp",
      "./plugins/with-windows-ninja",
      "./plugins/with-pod-deployment-target",
      "./plugins/with-app-icons",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d6f2fae2-e08b-4302-8b75-57a24ad14bb4"
      }
