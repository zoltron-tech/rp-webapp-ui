{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_NO_METRO_WORKSPACE_ROOT": "1"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "image": "latest"
      },
      "channel": "preview",
      "env": {
        "EXPO_NO_METRO_WORKSPACE_ROOT": "1"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "channel": "production",
      "env": {
        "EXPO_NO_METRO_WORKSPACE_ROOT": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
