# ─── Discord OAuth2 ───────────────────────────────────────────────────────────
# Your Discord application client ID from https://discord.com/developers/applications
# Used for the "Continue with Discord" OAuth2 flow.
# See https://discord.com/developers/docs/topics/oauth2
NEXT_PUBLIC_DISCORD_CLIENT_ID=
NEXT_PUBLIC_DISCORD_INVITE_URL=

# ─── Discord community sharing ────────────────────────────────────────────────
# Bot token + target channel ids used by /api/discord/share* to post embeds.
# All channels must live in DISCORD_GUILD_ID. Missing values disable sharing
# for that entity (the route replies 503).
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_PROMPT_SHARE_CHANNEL_ID=
DISCORD_MUSE_SHARE_CHANNEL_ID=
DISCORD_STORIES_CHANNEL_ID=
DISCORD_PROFILE_SHARE_CHANNEL_ID=

# ─── Backend service ──────────────────────────────────────────────────────────
# Base URL of the user/portfolio backend.
# LOCAL (no nginx): set RP_SERVICE_URL=http://localhost:3000 and enable the
# built-in dev proxy below — Next forwards /rp/user and /rp/portfolio to the
# local Spring services. PROD: the real api origin.
RP_SERVICE_URL=
RP_CHAT_URL=
RP_LOGIN_URL=

# ─── Local backend proxy (dev only, replaces nginx) ───────────────────────────
# Set to true to forward backend calls through Next to the local services.
LOCAL_BACKEND_PROXY=false
LOCAL_USER_SERVICE_URL=http://localhost:50100
LOCAL_PORTFOLIO_SERVICE_URL=http://localhost:50200

# ─── App config ───────────────────────────────────────────────────────────────
SUPPORT_EMAIL=
# Chat WebSocket origin. The socket provider early-returns when this is empty,
# so an unset value means chat silently never connects.
NEXT_PUBLIC_SOCKET_URL=

# Public-facing support address. Read by utils/constants/config.ts; the
# unprefixed SUPPORT_EMAIL above is a separate value read by utils/constants/common.ts.
NEXT_PUBLIC_SUPPORT_EMAIL=
VAPID_PUBLIC_KEY=
LOG_LEVEL=info
DISABLE_AUTOSCROLL=false
# Set true for local dev (localhost:3000): makes the auth cookie host-only and
# non-secure so it works over http. Required for Discord linking on localhost.
USE_LOCAL_DOMAIN=false
KLIPY_API_KEY=
RP_BUCKET_NAME=

# ─── Chat E2E encryption ──────────────────────────────────────────────────────
# Legacy secret used only to DECRYPT interim "e2e:v1:" messages (see
# src/utils/e2e-crypto.ts). Current messages use per-user ECDH keys instead.
# Optional — a built-in default is used when unset. Must keep whatever value
# was active while v1 messages were being sent, until they age out (14 days).
NEXT_PUBLIC_CHAT_E2E_SECRET=

# Feature flag: encrypt outgoing chat messages. Unset/empty → messages send as
# plaintext (key exchange, envelope repair, and decryption still run). Set to
# any non-empty value (e.g. true) to encrypt.
NEXT_PUBLIC_CHAT_E2E_ENABLED=

# ─── Vite (React migration) ───────────────────────────────────────────────────
# The Vite build only exposes VITE_-prefixed names to the browser. During the
# migration `vite.config.ts` falls back to the legacy name on the right when the
# VITE_ one is unset, so the values above keep working locally and nothing has to
# be duplicated yet. Set the VITE_ names in the Vercel project (Production,
# Preview AND Development) before the Phase D cutover; the fallback is removed
# when Next is deleted.
#
#   VITE_RP_SERVICE_URL       ← RP_SERVICE_URL
#   VITE_RP_CHAT_URL          ← RP_CHAT_URL
#   VITE_RP_LOGIN_URL         ← RP_LOGIN_URL
#   VITE_SOCKET_URL           ← NEXT_PUBLIC_SOCKET_URL
#   VITE_SUPPORT_EMAIL        ← NEXT_PUBLIC_SUPPORT_EMAIL, SUPPORT_EMAIL
#   VITE_VAPID_PUBLIC_KEY     ← VAPID_PUBLIC_KEY
#   VITE_LOG_LEVEL            ← NEXT_PUBLIC_LOG_LEVEL, LOG_LEVEL
#   VITE_DISABLE_AUTOSCROLL   ← DISABLE_AUTOSCROLL
#   VITE_DISCORD_INVITE_URL   ← NEXT_PUBLIC_DISCORD_INVITE_URL
#   VITE_CHAT_E2E_SECRET      ← NEXT_PUBLIC_CHAT_E2E_SECRET
#   VITE_CHAT_E2E_ENABLED     ← NEXT_PUBLIC_CHAT_E2E_ENABLED
#   VITE_USE_LOCAL_DOMAIN     ← USE_LOCAL_DOMAIN  (server-only today; the browser
#                                needs it once it writes the auth cookie)
#
# NOT VITE_-prefixed, and must never be: DISCORD_BOT_TOKEN, DISCORD_GUILD_ID,
# the four DISCORD_*_CHANNEL_ID values, KLIPY_API_KEY. Prefixing a secret ships
# it to the browser. These stay server-side and move to the BFF in Phase C.
