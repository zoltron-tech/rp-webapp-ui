{
  "name": "novelist-world-app",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace root. The web app lives in apps/web; shared logic in packages/*. See MONOREPO_MIGRATION_PLAN.md.",
  "scripts": {
    "dev": "pnpm --filter @nw/web dev",
    "build": "pnpm --filter @nw/web build",
    "start": "pnpm --filter @nw/web start",
    "lint": "biome check",
    "format": "biome format",
    "type-check": "pnpm --filter @nw/web type-check && pnpm --filter @nw/mobile type-check",
    "type-check:packages": "pnpm -r --filter \"./packages/**\" type-check",
    "check:boundaries": "node tools/check-package-boundaries.mjs",
    "verify": "pnpm type-check && pnpm type-check:packages && pnpm check:boundaries && pnpm smoke",
    "smoke": "pnpm --filter @nw/web smoke",
    "smoke:routes": "pnpm --filter @nw/web smoke:routes",
    "dev:mobile": "pnpm --filter @nw/mobile start"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad",
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    },
    "patchedDependencies": {
      "react-native@0.81.5": "patches/react-native@0.81.5.patch"
    }
  }
}
