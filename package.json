    "@trpc/server": "^10.45.2",
    "classnames": "^2.5.1",
    "cors": "^2.8.5",
    "emoji-mart": "^5.6.0",
    "emoji-picker-react": "^4.9.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "next": "14.0.4",
    "react": "^18",
    "react-colorful": "^5.6.1",
    "react-cookie": "^7.0.1",
