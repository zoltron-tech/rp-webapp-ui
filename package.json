{
  "name": "rp-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "preview:vite": "vite preview --port 3000",
    "smoke": "pnpm smoke:bff && pnpm smoke:mw",
    "smoke:bff": "tsx scripts/bff-smoke.ts",
    "smoke:mw": "tsx scripts/middleware-smoke.ts",
    "lint": "biome check ",
    "type-check": "tsc --noEmit",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "verify": "pnpm type-check && pnpm type-check:packages && pnpm check:boundaries",
    "push": "rm -rf .next && pnpm build && git add . && git commit -m \"$@\" && git fetch origin && git rebase origin/main && git push -f origin expanded-content",
    "update-local": "rm -rf node_modules/@novelist-world/ui/dist && cd ../novelist-world-ui && yarn build && cp -r dist ../rp-webapp-ui/node_modules/@novelist-world/ui/dist && cd ../rp-webapp-ui",
    "type-check:packages": "pnpm -r --filter \"./packages/**\" type-check"
  },
  "engines": {
    "node": ">=18.16.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@novelist-world/ui": "1.0.2-alpha-2",
    "@nw/api": "workspace:*",
    "@nw/types": "workspace:*",
    "@nw/utils": "workspace:*",
    "@radix-ui/colors": "^3.0.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@trpc/client": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "@vercel/edge": "^1.3.3",
    "classnames": "^2.5.1",
    "cors": "^2.8.5",
    "dompurify": "^3.3.1",
    "emoji-mart": "^5.6.0",
    "emoji-picker-react": "^4.13.2",
    "hono": "^4.13.5",
    "html-to-image": "^1.11.13",
    "jsonwebtoken": "^9.0.2",
    "lottie-react": "^2.4.1",
    "mediabunny": "^1.50.3",
    "moment": "^2.30.1",
    "next": "14.0.4",
    "nsfwjs": "^4.3.0",
    "radix-ui": "^1.4.2",
    "react": "^19.1.1",
    "react-colorful": "^5.6.1",
    "react-cookie": "^7.2.2",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-joyride": "^2.9.3",
    "react-qr-code": "^2.0.21",
    "react-router": "^7.18.3",
    "serve": "^14.2.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "styled-components": "^6.1.19",
    "swiper": "^11.2.10",
    "toastify-js": "^1.12.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@svgr/webpack": "^8.1.0",
    "@swc/plugin-styled-components": "^13.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.9",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/styled-components": "^5.1.34",
    "@types/swiper": "^6.0.0",
    "@types/toastify-js": "^1.12.4",
    "@types/ws": "^8.18.1",
    "@vercel/node": "^12.0.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
