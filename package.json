{
  "name": "rp-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "push": "rm -rf .next && yarn build && git add . && git commit -m \"$@\" && git fetch origin && git rebase origin/main && git push -f origin expanded-content",
    "update-local": "rm -rf node_modules/@novelist-world/ui/dist && cd ../novelist-world-ui && yarn build && cp -r dist ../rp-webapp-ui/node_modules/@novelist-world/ui/dist && cd ../rp-webapp-ui"
  },
