{
  "name": "@nw/richtext",
  "version": "0.0.0",
  "private": true,
  "description": "Parses the editor's saved HTML into a platform-neutral tree, and renders it through components each client supplies.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "node --import ./test/register.mjs --test \"test/**/*.test.ts\"",
    "type-check": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@nw/config": "workspace:*",
    "@types/react": "^19.1.9"
  }
}
