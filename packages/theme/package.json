{
  "name": "@nw/theme",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens — colours, accents, geometry. No styling engine, so both clients can read them.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nw/types": "workspace:*",
    "@nw/utils": "workspace:*"
  },
  "devDependencies": {
    "@nw/config": "workspace:*"
  }
}
