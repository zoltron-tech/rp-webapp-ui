{
  "extends": "@nw/config/tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "paths": {
      "@nw/types": ["../types/src"],
      "@nw/types/*": ["../types/src/*"],
      "@nw/utils": ["../utils/src"],
      "@nw/utils/*": ["../utils/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.js", "../config/universal-globals.d.ts"]
}
